{
  "schemaVersion": 1,
  "id": "dimensional-inventories-extension-trinkets",
  "version": "${version}",

  "name": "Dimensional Inventories Extension: Trinkets",
  "description": "An extension for Dimensional Inventories providing support for Trinkets.",
  "authors": [
    "Thomilist"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/dimensional-inventories-extension-trinkets",
    "sources": "https://github.com/thomilist/dimensional-inventories-extension-trinkets/",
    "issues": "https://github.com/Thomilist/dimensional-inventories-extension-trinkets/issues"
  },

  "license": "MIT",
  "icon": "assets/dimensional-inventories-extension-trinkets/icon.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "net.thomilist.dimensionalinventories.extension.trinkets.client.DimensionalInventoriesExtensionTrinketsClient"
    ],
    "main": [
      "net.thomilist.dimensionalinventories.extension.trinkets.DimensionalInventoriesExtensionTrinkets"
    ]
  },
  "mixins": [
    "dimensional-inventories-extension-trinkets.mixins.json",
    {
      "config": "dimensional-inventories-extension-trinkets.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "dimensional-inventories": ">=${dimensional_inventories_version}",
    "trinkets": ">=${trinkets_version}"
  }
}
